# 环境变量配置文件
# 本文件中定义的变量可以通过 import.meta.env.VITE_XXX 在代码中访问
# 只有以VITE_开头的变量才会被暴露给客户端代码

# API基础URL - 用于所有API请求的基础路径
# 开发环境留空，走 Vite 同源代理（见 vite.config.ts 的 /gateway），局域网 IP 访问才能带上登录 Cookie
# 若直连后端（如 http://localhost:12003），用 172.x 打开页面会出现跨站 POST 丢 Cookie、操作即未登录退出
VITE_API_BASE_URL =
# 开发代理目标（仅 Vite 使用，不会打进前端包）
VITE_API_PROXY_TARGET = 'http://127.0.0.1:12003'
# 应用标题 - 显示在浏览器标签页和应用界面中
# 可用于SEO和品牌展示
VITE_APP_TITLE = 'Flux Datahub Gateway'

# 应用描述 - 简短描述应用的功能或目的
# 可用于SEO和应用介绍
VITE_APP_DESC = 'A Vue 3 application'

# 开发请走真实后端；mock 登录不会种 session Cookie，随后任何接口都会 401 退出
VITE_USE_MOCK = false

# 应用版本号 - 标识当前应用的版本
# 可用于更新检测和问题追踪
VITE_APP_VERSION = '0.0.1' 

#日志打印模式
VITE_LOGGER_ENV = "dev"
# 基础路径配置
VITE_BASE_URL = '/gatewayweb'

# VitePress 帮助手册开发服务（与 package.json dev:docs 端口一致）。主应用 dev 将 /gatewayweb/docs 代理到此地址。
VITE_DOCS_DEV_TARGET = 'http://127.0.0.1:5274'